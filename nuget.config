<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 离线可复现构建：所有构建期 NuGet 依赖已 vendor 进 third_party/nuget，
       clear 后仅用本地源，无网机器 clone 即可 dotnet restore / MSBuild。
       新增 PackageReference 时须把对应 .nupkg（含传递依赖）一并放入该目录。 -->
  <packageSources>
    <clear />
    <add key="vendored" value="third_party/nuget" />
  </packageSources>
</configuration>
