<Window x:Class="TradosToolkit.Inbox.InboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 收件箱"
        Width="1040" Height="680" MinWidth="860" MinHeight="560"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="收" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="收件箱 · 拖入即产出"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="监视一个目录：投放文件 → 自动建项目 → 套本地库 → 出报告 / 交付包 / 匹配库"/>
        </StackPanel>

        <!-- 配置 + 启停 -->
        <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Text="监视目录"/>
                    <TextBox x:Name="WatchBox" Width="260" Height="30" VerticalAlignment="Center"
                             ToolTip="把待处理文件拖进这个目录即自动开始"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseWatch_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="产出目录" Margin="18,0,8,0"/>
                    <TextBox x:Name="OutputBox" Width="200" Height="30" VerticalAlignment="Center"
                             ToolTip="三件套（报告/交付包/匹配库）与项目都放在这里；留空用「文档\TradosToolkit 收件箱」"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="本地库目录"/>
                    <TextBox x:Name="TmBox" Width="260" Height="30" VerticalAlignment="Center"
                             ToolTip="从这个目录（含子目录）里挑语言对匹配的 .sdltm 套进项目"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseTm_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="源语言" Margin="18,0,8,0"/>
                    <TextBox x:Name="SourceLangBox" Width="90" Height="30" VerticalAlignment="Center"
                             ToolTip="ISO 代码，如 zh-CN / en-US"/>
                    <TextBlock Style="{StaticResource Label}" Text="目标语言" Margin="12,0,8,0"/>
                    <TextBox x:Name="TargetLangBox" Width="90" Height="30" VerticalAlignment="Center"
                             ToolTip="ISO 代码，如 en-US / zh-CN"/>
                    <CheckBox x:Name="AutoStartBox" Content="随插件自动开始监视" VerticalAlignment="Center"
                              Margin="18,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ToggleBtn" Content="开始监视" Style="{StaticResource JadeButton}" Click="Toggle_Click"/>
                    <Button x:Name="ProcessBtn" Content="立即处理收件箱" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="ProcessExisting_Click"/>
                    <Button x:Name="OpenOutBtn" Content="打开产出目录" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="OpenOutput_Click"/>
                    <Button x:Name="HelpBtn" Content="?" Style="{StaticResource GhostButton}" Width="28"
                            FontWeight="Bold" Padding="0" Margin="14,0,0,0" Click="Help_Click"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="14,0,0,0" Text="未开始监视"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 任务列表 + 流程详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Sub}" Margin="0,0,0,6"
                               Text="任务列表（点击一行看它的分步流程与日志）"/>
                    <DataGrid x:Name="JobGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionChanged="JobGrid_SelectionChanged"
                              BorderThickness="0" Background="Transparent"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22DFE4EB"
                              RowHeight="30" AlternatingRowBackground="#16000000"
                              FontSize="12.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="70"/>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="70"/>
                            <DataGridTextColumn Header="产出" Binding="{Binding OutputSummary}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Sub}" Text="流程监控"/>
                    <TextBlock Grid.Row="1" x:Name="DetailTitle" FontWeight="SemiBold" Margin="0,4,0,8"
                               TextTrimming="CharacterEllipsis" Text="（未选择任务）"/>
                    <ItemsControl Grid.Row="2" x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="3" Style="{StaticResource Sub}" Text="日志" Margin="0,4,0,4"/>
                    <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="11.5" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#FFFBFCFE" BorderBrush="#FFE3E8EF"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Style="{StaticResource Tile}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource Sub}"
                       TextTrimming="CharacterEllipsis"
                       Text="把文件拖进监视目录即可；也可点「立即处理收件箱」处理已有文件。"/>
        </Border>
    </Grid>
</Window>
