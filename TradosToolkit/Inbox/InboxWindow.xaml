<Window x:Class="TradosToolkit.Inbox.InboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 收件箱"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <DataTemplate x:Key="LangItemTemplate">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>

            <!-- 带搜索框的语言下拉：与术语管理同一套样式。点开后 Popup 顶部有输入框，输入即过滤，
                 回车=选中过滤后第一项，收起未点选则回显当前语向。窗口跑专用 STA 线程后键盘链路正常。 -->
            <Style x:Key="LangSearchCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ItemTemplate" Value="{StaticResource LangItemTemplate}"/>
                <!-- 语言近 460 种，默认条目宿主不虚拟化会全量生成容器而卡顿，换 VirtualizingStackPanel -->
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ComboBorder" Background="{DynamicResource RegionBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" Margin="9,0,0,0"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource SecondaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="True"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <StackPanel>
                                            <Grid Margin="8,8,8,4">
                                                <TextBox x:Name="LangSearchBox" Height="26" FontSize="12" Padding="5,0" Focusable="True"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock x:Name="SearchHint" Text="输入代码或名称过滤…" Foreground="{DynamicResource ThirdlyTextBrush}" FontSize="12"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                            <Separator Margin="6,0"/>
                                            <ScrollViewer MaxHeight="260" CanContentScroll="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.ScrollUnit="Item"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="LangSearchBox" Property="Text" Value="">
                                    <Setter TargetName="SearchHint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            </Style>
            <Style x:Key="StepDetail" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="收" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="收件箱 · 拖入即产出"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="监视一个目录：投放文件 → 自动建项目 → 套本地库 → 出报告 / 交付包 / 匹配库"/>
        </StackPanel>

        <!-- 配置 + 启停 -->
        <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Text="监视目录"/>
                    <TextBox x:Name="WatchBox" Width="260" Height="30" VerticalAlignment="Center"
                             ToolTip="把待处理文件拖进这个目录即自动开始"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseWatch_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="产出目录" Margin="18,0,8,0"/>
                    <TextBox x:Name="OutputBox" Width="200" Height="30" VerticalAlignment="Center"
                             ToolTip="三件套（报告/交付包/匹配库）与项目都放在这里；留空用「文档\TradosToolkit 收件箱」"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="本地库目录"/>
                    <TextBox x:Name="TmBox" Width="260" Height="30" VerticalAlignment="Center"
                             ToolTip="从这个目录（含子目录）里挑语言对匹配的 .sdltm 套进项目"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseTm_Click"/>
                    <TextBlock Style="{StaticResource Label}" Text="源语言" Margin="18,0,8,0"/>
                    <ComboBox x:Name="SrcCombo" Width="150" Style="{StaticResource LangSearchCombo}"
                              SelectedValuePath="Code" SelectionChanged="LangChanged"
                              ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                    <TextBlock Style="{StaticResource Label}" Text="目标语言" Margin="12,0,8,0"/>
                    <ComboBox x:Name="TgtCombo" Width="150" Style="{StaticResource LangSearchCombo}"
                              SelectedValuePath="Code" SelectionChanged="LangChanged"
                              ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                    <CheckBox x:Name="AutoStartBox" Content="随插件自动开始监视" VerticalAlignment="Center"
                              Margin="18,0,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="报告格式"/>
                    <ComboBox x:Name="ReportFormatCombo" Width="180" Height="30" VerticalAlignment="Center"
                              SelectionChanged="ReportFormatChanged"
                              ToolTip="分析报告「另存为」的格式（Trados 原生报告引擎）：Excel(.xls)/XML/HTML/MHT，随配置保存并立即生效">
                        <ComboBoxItem Content="Excel（.xls）" Tag="excel"/>
                        <ComboBoxItem Content="XML（.xml）" Tag="xml"/>
                        <ComboBoxItem Content="HTML（.html）" Tag="html"/>
                        <ComboBoxItem Content="MHT（.mht）" Tag="mht"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="默认 Excel；改后立即生效，无需重启监视"/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ToggleBtn" Content="开始监视" Style="{StaticResource JadeButton}" Click="Toggle_Click"/>
                    <Button x:Name="ProcessBtn" Content="立即处理收件箱" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="ProcessExisting_Click"/>
                    <Button x:Name="OpenOutBtn" Content="打开产出目录" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="OpenOutput_Click"/>
                    <Button x:Name="HelpBtn" Content="?" Style="{StaticResource GhostButton}" Width="28"
                            FontWeight="Bold" Padding="0" Margin="14,0,0,0" Click="Help_Click"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="14,0,0,0" Text="未开始监视"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 任务列表 + 流程详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.32*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.18*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Sub}" Margin="0,0,0,6"
                               Text="任务列表（点击一行看它的分步流程与日志）"/>
                    <DataGrid x:Name="JobGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionChanged="JobGrid_SelectionChanged"
                              BorderThickness="0" Background="Transparent"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#22DFE4EB"
                              RowHeight="36" AlternatingRowBackground="#16000000"
                              FontSize="13.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="86"/>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="86"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="86"/>
                            <DataGridTextColumn Header="产出" Binding="{Binding OutputSummary}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.95*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.6*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Sub}" Text="流程监控"/>
                    <TextBlock Grid.Row="1" x:Name="DetailTitle" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,10"
                               TextTrimming="CharacterEllipsis" Text="（未选择任务）"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0" Focusable="False">
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="94"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource StepDetail}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" Style="{StaticResource Sub}" Text="日志" Margin="0,6,0,5"/>
                    <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="13" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="190"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#FFFBFCFE" BorderBrush="#FFE3E8EF"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Style="{StaticResource Tile}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource Sub}"
                       TextTrimming="CharacterEllipsis"
                       Text="把文件拖进监视目录即可；也可点「立即处理收件箱」处理已有文件。"/>
        </Border>
    </Grid>
</Window>
