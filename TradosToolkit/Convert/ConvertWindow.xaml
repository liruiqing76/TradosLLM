<Window x:Class="TradosToolkit.FileConvert.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradosToolkit 文件转换"
        Width="820" Height="560" MinWidth="720" MinHeight="500"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            </Style>
            <Style x:Key="LangCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="DisplayMemberPath" Value="Label"/>
                <Setter Property="SelectedValuePath" Value="Code"/>
                <Setter Property="IsTextSearchEnabled" Value="True"/>
                <Setter Property="TextSearch.TextPath" Value="Label"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="转" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="文件转换 · 任意文件 → sdlxliff"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="一次性转换：临时建项目解析源文件，产出目标 sdlxliff，不留项目"/>
        </StackPanel>

        <!-- 参数 -->
        <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Text="输入文件" Width="60"/>
                    <TextBox x:Name="InputBox" Width="520" Height="30" VerticalAlignment="Center"
                             ToolTip="任意受 Studio 文件类型系统支持的源文件：docx/xlsx/pptx/txt/xml/html 等"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseInput_Click"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="源语言" Width="60"/>
                    <ComboBox x:Name="SrcCombo" Width="210" Style="{StaticResource LangCombo}"
                              ToolTip="输入代码或名称首字母即可定位"/>
                    <TextBlock Style="{StaticResource Label}" Text="目标语言" Margin="18,0,10,0"/>
                    <ComboBox x:Name="TgtCombo" Width="210" Style="{StaticResource LangCombo}"
                              ToolTip="输入代码或名称首字母即可定位"/>
                    <CheckBox x:Name="KeepBox" Content="保留临时项目" VerticalAlignment="Center" Margin="18,0,0,0"
                              ToolTip="勾选后转换完不删除临时项目目录，便于排查；默认转换完即清理"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="输出文件" Width="60"/>
                    <TextBox x:Name="OutputBox" Width="520" Height="30" VerticalAlignment="Center"
                             ToolTip="留空 = 输入文件同目录、同名加 .sdlxliff"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="项目模板" Width="60"/>
                    <TextBox x:Name="TemplateBox" Width="520" Height="30" VerticalAlignment="Center"
                             ToolTip="留空 = 自动挑一个 Studio 项目模板（按语言对匹配）"/>
                    <Button Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseTemplate_Click"/>
                </WrapPanel>

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ConvertBtn" Content="开始转换" Style="{StaticResource JadeButton}" Click="Convert_Click"/>
                    <Button x:Name="OpenOutBtn" Content="打开输出位置" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" IsEnabled="False" Click="OpenOutput_Click"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="14,0,0,0" Text="就绪"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="2" Style="{StaticResource Tile}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Sub}" Text="转换日志" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="#FFFBFCFE" BorderBrush="#FFE3E8EF"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Tile}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis"
                       Text="提示：PDF/扫描件等需先装对应文件类型过滤器；等价命令行接口 POST /api/convert。"/>
        </Border>
    </Grid>
</Window>
