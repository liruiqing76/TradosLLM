<Window x:Class="TradosToolkit.TranslationProvider.UI.ProviderConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 翻译提供程序"
        Width="620" Height="560"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{DynamicResource TabControlInLine}"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="翻译引擎">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,14,6,2">
                    <StackPanel>
                        <!-- TM 统一接口 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TM 统一接口（优先）" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse x:Name="TmDot" Width="9" Height="9" Fill="#C0C6D2"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TmStatusLabel" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="查询顺序：TM/本地库统一接口优先返回；未命中的段落自动回退 LLM。接口地址在 %APPDATA%\TradosToolkit\config.json 的 tmUrl 配置。"/>
                            </StackPanel>
                        </Border>

                        <!-- LLM 回退 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LLM 回退（OpenAI 兼容，可不填 = 仅用 TM）" Style="{StaticResource SectionTitle}"/>
                                <hc:TextBox x:Name="BaseUrlBox" Margin="0,6"
                                            hc:InfoElement.Title="Base URL"
                                            hc:InfoElement.Necessary="True"
                                            hc:InfoElement.Placeholder="https://api.example.com/v1"
                                            Style="{StaticResource TextBoxExtend}"/>
                                <hc:TextBox x:Name="ModelBox" Margin="0,6"
                                            hc:InfoElement.Title="模型"
                                            hc:InfoElement.Necessary="True"
                                            hc:InfoElement.Placeholder="例如 high_quality / deepseek-chat，不是 API Key"
                                            Style="{StaticResource TextBoxExtend}"/>
                                <PasswordBox x:Name="ApiKeyBox" Margin="0,6"
                                             hc:InfoElement.Title="API Key"
                                             hc:InfoElement.Placeholder="sk-…（留空 = 沿用已保存的 Key）"
                                             Style="{StaticResource PasswordBoxExtend}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                    <Ellipse x:Name="ApiKeyDot" Width="9" Height="9" Fill="#C0C6D2"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ApiKeyStatusLabel" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="API Key 自动保存到 %APPDATA%\TradosToolkit\config.json，填一次即可；更换 Key 时在此填入新值保存。"/>
                            </StackPanel>
                        </Border>

                        <!-- 标签处理 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="标签处理" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="TagsCheck" IsChecked="True"
                                          Content="保留标签（用 [[n]] 占位符保护标签并回填译文；关闭则输出纯文本）"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="自定义术语">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,14,6,2">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="术语替换开关" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                           Text="术语库为本地 SQLite，翻译时按语言对自动加载。"/>
                                <CheckBox x:Name="PreGlossaryCheck" Margin="0,6"
                                          Content="译前替换源文术语（发送翻译前替换源语言术语）"/>
                                <CheckBox x:Name="PostGlossaryCheck" Margin="0,6"
                                          Content="译后替换译文（翻译完成后修正译文中的词，100% 生效）"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="维护词条、导入导出：" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button Style="{DynamicResource ButtonDefault}" Content="术语管理…"
                                        Padding="16,6" Click="OpenGlossaryManager"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,12" Margin="-20,12,-20,0">
            <Grid Margin="20,0">
                <Button Style="{DynamicResource ButtonDefault}" Content="打开日志目录"
                        HorizontalAlignment="Left" Padding="12,6" Click="OpenLogFolder_Click"
                        ToolTip="在资源管理器中打开 %APPDATA%\TradosToolkit\logs（按天/5MB 自动轮转，保留最近 14 份）"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Style="{DynamicResource ButtonPrimary}" Content="确定"
                            MinWidth="96" IsDefault="True" Click="OkButton_Click"/>
                    <Button Style="{DynamicResource ButtonDefault}" Content="取消"
                            MinWidth="96" Margin="12,0,0,0" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
