<Window x:Class="TradosToolkit.TranslationProvider.UI.GlossaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 术语管理"
        Width="940" Height="580" MinWidth="760" MinHeight="520"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 带搜索框的语言下拉：点开下拉顶部有可见输入框，输入即过滤（不依赖可编辑组合框的焦点技巧）。
                 注意：Popup 必须 Focusable=True，否则独立弹出窗口不可激活、搜索框收不到键盘输入；
                 选择框文本用显式 ItemTemplate（自定义模板下 DisplayMemberPath 的 SelectionBoxItemTemplate 不生效，会显示 ToString）。 -->
            <Style x:Key="LangSearchCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <!-- 关键：非编辑 ComboBox 默认 IsTextSearchEnabled=true，英文按键会被截去做列表首字母跳转
                     （TextInput 在 ComboBox 层被 Handled，到不了下拉里的搜索框）；中文 IME 走组合输入
                     通道不受影响 —— 表现为"中文能输、英文不能输"。必须关掉。 -->
                <Setter Property="IsTextSearchEnabled" Value="False"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="White" BorderBrush="#FFCFD6DF" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter x:Name="SelectionBox" Grid.Column="0" Margin="9,0,0,0"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FF7A869A"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF3A7BD5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="True"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="White" BorderBrush="#FFDFE4EB" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <StackPanel>
                                            <Grid Margin="8,8,8,4">
                                                <TextBox x:Name="LangSearchBox" Height="26" FontSize="12" Padding="5,0" Focusable="True"
                                                         VerticalContentAlignment="Center" BorderBrush="#FFCFD6DF" BorderThickness="1"/>
                                                <TextBlock x:Name="SearchHint" Text="输入代码或名称过滤…" Foreground="#FF9AA5B1" FontSize="12"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                            <Separator Margin="6,0" Background="#FFEEF1F5"/>
                                            <ScrollViewer MaxHeight="260" CanContentScroll="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.ScrollUnit="Item"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 空关键词时显示占位提示文字 -->
                                <Trigger SourceName="LangSearchBox" Property="Text" Value="">
                                    <Setter TargetName="SearchHint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="术" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="术语管理"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="译前(替换源文) / 译后(替换译文) 两套本地术语库 · 语言可输入过滤 · 按领域隔离"/>
        </StackPanel>

        <!-- 筛选区：第一行=术语类型+语言对；第二行=领域+搜索+操作按钮（固定两行，不再 WrapPanel 换行错位） -->
        <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="术语类型" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox x:Name="KindCombo" Width="132" Height="30" VerticalAlignment="Center"
                              SelectedIndex="0" SelectionChanged="KindChanged">
                        <ComboBoxItem Content="译前（替换源文）"/>
                        <ComboBoxItem Content="译后（替换译文）"/>
                    </ComboBox>

                    <TextBlock Text="语言对" VerticalAlignment="Center" Margin="18,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox x:Name="SrcCombo" Width="200" Style="{StaticResource LangSearchCombo}"
                              SelectedValuePath="Code"
                              SelectionChanged="LangChanged"
                              ToolTip="点开下拉，顶部输入框里直接敲代码/名称即可过滤"/>
                    <TextBlock Text=" → " VerticalAlignment="Center" Margin="6,0,6,0"
                               Foreground="{DynamicResource ThirdlyTextBrush}"/>
                    <ComboBox x:Name="TgtCombo" Width="200" Style="{StaticResource LangSearchCombo}"
                              SelectedValuePath="Code"
                              SelectionChanged="LangChanged"
                              ToolTip="点开下拉，顶部输入框里直接敲代码/名称即可过滤"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="领域" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="DomCombo" Width="110" Height="30" VerticalAlignment="Center"
                                  SelectionChanged="DomainChanged"
                                  ToolTip="全局领域：只显示/写入当前领域的术语；与翻译插件共用一个领域，工作台可直接切换"/>

                        <TextBlock Text="搜索" VerticalAlignment="Center" Margin="18,0,8,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="TermSearchBox" Width="170" Height="28" VerticalAlignment="Center"
                                 ToolTip="按 来源/目标/领域 过滤已加载术语（留空显示全部）"
                                 TextChanged="TermSearch_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LoadBtn" Content="加载术语" Style="{StaticResource JadeButton}"
                                Margin="0,0,8,0" Click="Reload"/>
                        <Button x:Name="TemplateBtn" Content="下载模板" Style="{StaticResource GhostButton}"
                                ToolTip="下载一个只有表头的 CSV 模板(from,to)" Click="DownloadTemplate"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 术语表 -->
        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource TileBorderBrush}">
            <DataGrid x:Name="TermsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="替换前 (from)" Binding="{Binding From}" Width="*"/>
                    <DataGridTextColumn Header="替换为 (to)" Binding="{Binding To}" Width="*"/>
                    <DataGridTextColumn Header="领域" Binding="{Binding Domain}" Width="100"
                                        IsReadOnly="False"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="新增" Style="{StaticResource JadeButton}" Width="76" Click="AddTerm"/>
            <Button Content="删除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteTerms"/>
            <Button Content="保存修改" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SaveTerms"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Width="90" Click="ImportCsv"/>
            <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Width="90" Margin="8,0,0,0" Click="ExportCsv"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="关闭" Style="{StaticResource GhostButton}" Width="76" Margin="8,0,0,0" Click="CloseButton"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
    </Grid>
</Window>