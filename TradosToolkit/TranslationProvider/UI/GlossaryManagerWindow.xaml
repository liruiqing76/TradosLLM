<Window x:Class="TradosToolkit.TranslationProvider.UI.GlossaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 术语管理"
        Width="940" Height="580" MinWidth="760" MinHeight="520"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <DataTemplate x:Key="LangItemTemplate">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 语言下拉：普通选择框（非编辑，选一项显示 Label）。过滤输入走下拉外面的常驻文本框
                 LangFilterBox——它是窗口表面的普通 TextBox，与"搜索"术语框同类控件，Studio 里输入一向正常；
                 输入只改每框 ListCollectionView.Filter 实时收窄，已选语言被 pin 住不会被筛成空白。
                 之前两版依赖 Popup 的方案（下拉内搜索框、hc:ComboBox AutoComplete 候选层）在 Studio 宿主
                 下 Popup 独立窗口拿不到 Win32 键盘激活，实测都进不去字，故彻底不用弹层做输入。
                 Src/Tgt 属性直接内联写在元素上（不加 x:Key 样式）：带键样式会顶掉 HC 隐式模板样式。 -->
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="术" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="术语管理"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="译前(替换源文) / 译后(替换译文) 两套本地术语库 · 语言可输入过滤 · 按领域隔离"/>
        </StackPanel>

        <!-- 筛选区：第一行=术语类型+语言对；第二行=领域+搜索+操作按钮（固定两行，不再 WrapPanel 换行错位） -->
        <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="术语类型" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox x:Name="KindCombo" Width="132" Height="30" VerticalAlignment="Center"
                              SelectedIndex="0" SelectionChanged="KindChanged">
                        <ComboBoxItem Content="译前（替换源文）"/>
                        <ComboBoxItem Content="译后（替换译文）"/>
                    </ComboBox>

                    <TextBlock Text="语言对" VerticalAlignment="Center" Margin="18,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid Width="132" Height="30" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBox x:Name="LangFilterBox" VerticalContentAlignment="Center"
                                 TextChanged="LangFilter_TextChanged"
                                 ToolTip="输入语言代码或名称（如 en / chinese / zh），实时收窄右边两个下拉"/>
                        <TextBlock Text="输入代码/名称过滤…" Foreground="#FF9AA5B1" FontSize="12"
                                   Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LangFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="SrcCombo" Width="188" Height="30" VerticalAlignment="Center"
                              IsTextSearchEnabled="False"
                              SelectedValuePath="Code"
                              SelectionChanged="LangChanged"
                              ToolTip="在左边过滤框输关键词收窄后点选"
                              ItemTemplate="{StaticResource LangItemTemplate}"/>
                    <TextBlock Text=" → " VerticalAlignment="Center" Margin="6,0,6,0"
                               Foreground="{DynamicResource ThirdlyTextBrush}"/>
                    <ComboBox x:Name="TgtCombo" Width="188" Height="30" VerticalAlignment="Center"
                              IsTextSearchEnabled="False"
                              SelectedValuePath="Code"
                              SelectionChanged="LangChanged"
                              ToolTip="在左边过滤框输关键词收窄后点选"
                              ItemTemplate="{StaticResource LangItemTemplate}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="领域" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="DomCombo" Width="110" Height="30" VerticalAlignment="Center"
                                  SelectionChanged="DomainChanged"
                                  ToolTip="全局领域：只显示/写入当前领域的术语；与翻译插件共用一个领域，工作台可直接切换"/>

                        <TextBlock Text="搜索" VerticalAlignment="Center" Margin="18,0,8,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="TermSearchBox" Width="170" Height="28" VerticalAlignment="Center"
                                 ToolTip="按 来源/目标/领域 过滤已加载术语（留空显示全部）"
                                 TextChanged="TermSearch_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LoadBtn" Content="加载术语" Style="{StaticResource JadeButton}"
                                Margin="0,0,8,0" Click="Reload"/>
                        <Button x:Name="TemplateBtn" Content="下载模板" Style="{StaticResource GhostButton}"
                                ToolTip="下载一个只有表头的 CSV 模板(from,to)" Click="DownloadTemplate"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 术语表 -->
        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource TileBorderBrush}">
            <DataGrid x:Name="TermsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="替换前 (from)" Binding="{Binding From}" Width="*"/>
                    <DataGridTextColumn Header="替换为 (to)" Binding="{Binding To}" Width="*"/>
                    <DataGridTextColumn Header="领域" Binding="{Binding Domain}" Width="100"
                                        IsReadOnly="False"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="新增" Style="{StaticResource JadeButton}" Width="76" Click="AddTerm"/>
            <Button Content="删除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteTerms"/>
            <Button Content="保存修改" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SaveTerms"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Width="90" Click="ImportCsv"/>
            <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Width="90" Margin="8,0,0,0" Click="ExportCsv"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="关闭" Style="{StaticResource GhostButton}" Width="76" Margin="8,0,0,0" Click="CloseButton"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </WrapPanel>
    </Grid>
</Window>