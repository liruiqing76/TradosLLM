<Window x:Class="TradosToolkit.TranslationProvider.UI.GlossaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradosToolkit 术语管理"
        Width="640" Height="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="类型：" VerticalAlignment="Center"/>
            <ComboBox x:Name="KindCombo" Width="110" SelectedIndex="0" SelectionChanged="Reload">
                <ComboBoxItem Content="译前（替换源文）"/>
                <ComboBoxItem Content="译后（替换译文）"/>
            </ComboBox>
            <TextBlock Text="语言对：" Margin="16,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="SrcBox" Width="90" VerticalAlignment="Center"/>
            <TextBlock Text=" → " VerticalAlignment="Center"/>
            <TextBox x:Name="TgtBox" Width="90" VerticalAlignment="Center"/>
            <Button Content="加载" Width="60" Height="24" Margin="12,0,0,0" Click="Reload"/>
        </StackPanel>

        <DataGrid x:Name="TermsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="替换前 (from)" Binding="{Binding From}" Width="*"/>
                <DataGridTextColumn Header="替换为 (to)" Binding="{Binding To}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="新增" Width="72" Height="26" Click="AddTerm"/>
            <Button Content="删除选中" Width="72" Height="26" Margin="8,0,0,0" Click="DeleteTerms"/>
            <Button Content="保存修改" Width="72" Height="26" Margin="8,0,0,0" Click="SaveTerms"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="导入 CSV" Width="80" Height="26" Click="ImportCsv"/>
            <Button Content="导出 CSV" Width="80" Height="26" Margin="8,0,0,0" Click="ExportCsv"/>
            <Button Content="关闭" Width="72" Height="26" Margin="8,0,0,0" Click="CloseButton"/>
        </WrapPanel>
    </Grid>
</Window>
