<Window x:Class="TradosToolkit.TranslationProvider.UI.GlossaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 术语管理"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2B6FBB"/>
            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <DataTemplate x:Key="LangItemTemplate">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 带搜索框的语言下拉：点开后 Popup 顶部有可见输入框，输入即过滤（即输即筛），
                 回车=选中过滤后第一项，收起未点选则回显当前语向。
                 窗口跑专用 STA 线程后键盘链路正常，Popup 可正常激活收字——旧版在 Studio 宿主线程
                 下 Popup 拿不到键盘才改用"下拉外过滤框"，根因修复后恢复本设计。
                 注意：Popup 必须 Focusable=True，否则独立弹出窗口不可激活、搜索框收不到键盘输入；
                 选择框文本用显式 ItemTemplate（自定义模板下 DisplayMemberPath 的
                 SelectionBoxItemTemplate 不生效，会显示 ToString）。 -->
            <Style x:Key="LangSearchCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ItemTemplate" Value="{StaticResource LangItemTemplate}"/>
                <!-- 关键：ComboBox 默认条目宿主是普通 StackPanel（不虚拟化），~460 个语言每次点开
                     都全量生成容器导致明显卡顿（无 HC 样式实测 200-435ms/次）；换成
                     VirtualizingStackPanel 后只生成可见的十几个（29-43ms），tools/test-lang-combo-open-speed.ps1 A/B 实测。 -->
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ComboBorder" Background="{DynamicResource RegionBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" Margin="9,0,0,0"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource SecondaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="True"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <StackPanel>
                                            <Grid Margin="8,8,8,4">
                                                <TextBox x:Name="LangSearchBox" Height="26" FontSize="12" Padding="5,0" Focusable="True"
                                                         VerticalContentAlignment="Center"/>
                                                <TextBlock x:Name="SearchHint" Text="输入代码或名称过滤…" Foreground="{DynamicResource ThirdlyTextBrush}" FontSize="12"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                            <Separator Margin="6,0"/>
                                            <ScrollViewer MaxHeight="260" CanContentScroll="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.ScrollUnit="Item"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 空关键词时显示占位提示文字 -->
                                <Trigger SourceName="LangSearchBox" Property="Text" Value="">
                                    <Setter TargetName="SearchHint" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="术" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource PageTitle}" Text="术语管理"/>
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"
                       Text="「替换词条」用于翻译流水线译前/译后替换；「术语表」是真正的术语库（供 Studio 术语识别/项目挂载），两者独立"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectionChanged="MainTabChanged">
            <!-- ================= 页签一：替换词条（译前/译后，扁平 from→to，供流水线替换） ================= -->
            <TabItem Header="替换词条（译前/译后）">
                <Grid Margin="2,12,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Tile}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="替换阶段" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="KindCombo" Width="132" Height="30" VerticalAlignment="Center"
                                          SelectedIndex="0" SelectionChanged="KindChanged">
                                    <ComboBoxItem Content="译前（替换源文）"/>
                                    <ComboBoxItem Content="译后（替换译文）"/>
                                </ComboBox>

                                <TextBlock Text="语言对" VerticalAlignment="Center" Margin="18,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="ReplSrcCombo" Width="238" Margin="0,0,8,0"
                                          Style="{StaticResource LangSearchCombo}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="LangChanged"
                                          ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                                <TextBlock Text=" → " VerticalAlignment="Center" Margin="6,0,6,0"
                                           Foreground="{DynamicResource ThirdlyTextBrush}"/>
                                <ComboBox x:Name="ReplTgtCombo" Width="238"
                                          Style="{StaticResource LangSearchCombo}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="LangChanged"
                                          ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="领域" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="ReplDomCombo" Width="110" Height="30" VerticalAlignment="Center"
                                              SelectionChanged="DomainChanged"
                                              ToolTip="全局领域：只显示/写入当前领域的替换词条；与翻译插件共用同一领域"/>

                                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="18,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="ReplSearchBox" Width="170" Height="28" VerticalAlignment="Center"
                                             ToolTip="按 替换前/替换为/领域 过滤（留空显示全部）"
                                             TextChanged="ReplSearch_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="加载" Style="{StaticResource JadeButton}"
                                            Margin="0,0,8,0" Click="Reload"/>
                                    <Button Content="下载模板" Style="{StaticResource GhostButton}"
                                            ToolTip="下载只有表头的 CSV 模板(from,to)" Click="DownloadTemplate"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource TileBorderBrush}">
                        <DataGrid x:Name="ReplGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F5"
                                  ToolTip="双击一行修改；新增请点左下角「新增」">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="替换前" Binding="{Binding From}" Width="*"/>
                                <DataGridTextColumn Header="替换为" Binding="{Binding To}" Width="*"/>
                                <DataGridTextColumn Header="领域" Binding="{Binding Domain}" Width="110"/>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtText}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="新增" Style="{StaticResource JadeButton}" Width="76" Click="AddReplTerm"
                                ToolTip="填写 替换前/替换为，确定即入库（供译前/译后替换使用）"/>
                        <Button Content="删除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteReplTerms"/>
                        <Separator Width="12" Background="Transparent"/>
                        <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Width="90" Click="ImportReplCsv"/>
                        <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Width="90" Margin="8,0,0,0" Click="ExportReplCsv"/>
                        <TextBlock x:Name="ReplStatusText" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ================= 页签二：术语表（完整模型，供术语识别/项目挂载） ================= -->
            <TabItem Header="术语表（术语识别）">
                <Grid Margin="2,12,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Tile}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="语言对" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="SrcCombo" Width="238" Margin="0,0,8,0"
                                          Style="{StaticResource LangSearchCombo}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="LangChanged"
                                          ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                                <TextBlock Text=" → " VerticalAlignment="Center" Margin="6,0,6,0"
                                           Foreground="{DynamicResource ThirdlyTextBrush}"/>
                                <ComboBox x:Name="TgtCombo" Width="238"
                                          Style="{StaticResource LangSearchCombo}"
                                          SelectedValuePath="Code"
                                          SelectionChanged="LangChanged"
                                          ToolTip="点开下拉，顶部输入框里敲代码/名称即可过滤，回车选中第一项"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="领域" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="DomCombo" Width="110" Height="30" VerticalAlignment="Center"
                                              SelectionChanged="DomainChanged"
                                              ToolTip="全局领域：只显示/写入当前领域的术语；与翻译插件共用一个领域"/>

                                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="18,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="TermSearchBox" Width="170" Height="28" VerticalAlignment="Center"
                                             ToolTip="按 源术语/目标术语/领域/定义/同义词 过滤（留空显示全部）"
                                             TextChanged="TermSearch_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="加载术语" Style="{StaticResource JadeButton}"
                                            Margin="0,0,8,0" Click="Reload"/>
                                    <Button Content="下载模板" Style="{StaticResource GhostButton}"
                                            ToolTip="下载完整字段的 CSV 模板" Click="DownloadTemplate"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource TileBorderBrush}">
                        <DataGrid x:Name="TermsGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F5"
                                  ToolTip="双击一行修改该术语条目；新增请点左下角「新增」"
                                  MouseDoubleClick="EditTerm">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="源术语" Binding="{Binding FromTerm}" Width="*"/>
                                <DataGridTextColumn Header="目标术语" Binding="{Binding ToTerm}" Width="*"/>
                                <DataGridTextColumn Header="词性" Binding="{Binding PartOfSpeechText}" Width="72"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="64"/>
                                <DataGridTextColumn Header="领域" Binding="{Binding Domain}" Width="96"/>
                                <DataGridTextColumn Header="同义词" Binding="{Binding SynonymText}" Width="150"/>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtText}" Width="126"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="新增" Style="{StaticResource JadeButton}" Width="76" Click="AddTerm"
                                ToolTip="弹出完整表单（源/目标术语、词性、状态、同义词、定义、例句、备注）"/>
                        <Button Content="删除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteTerms"/>
                        <Separator Width="12" Background="Transparent"/>
                        <Button Content="导入 CSV" Style="{StaticResource GhostButton}" Width="90" Click="ImportCsv"/>
                        <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Width="90" Margin="8,0,0,0" Click="ExportCsv"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>