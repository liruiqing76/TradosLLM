<Window x:Class="TradosToolkit.TranslationProvider.UI.TermDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="术语"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="TileBrush" Color="#FFFAFBFD"/>
            <SolidColorBrush x:Key="TileBorderBrush" Color="#FFDFE4EB"/>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
            </Style>
            <Style x:Key="HeaderEmblem" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A7BD5" Offset="0"/>
                            <GradientStop Color="#FF2B6FBB" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="JadeButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Padding" Value="15,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头：标题随新增/修改切换，副标题带出术语类型与语言对 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource HeaderEmblem}" Margin="0,0,10,0">
                <TextBlock Text="术" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="新增术语"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
        </StackPanel>

        <!-- 表单：标签在左、输入在右；创建/更新时间仅"修改"时出现 -->
        <Border Grid.Row="1" Style="{StaticResource Tile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="替换前 (from)" Margin="0,0,10,12"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,12"
                         Padding="6,0" VerticalContentAlignment="Center"
                         ToolTip="要被替换掉的那段文字（必填）"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="替换为 (to)" Margin="0,0,10,12"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,12"
                         Padding="6,0" VerticalContentAlignment="Center"
                         ToolTip="替换后的内容；留空表示把命中的内容删掉"/>

                <TextBlock x:Name="DomLabel" Grid.Row="2" Grid.Column="0" Text="领域" Margin="0,0,10,12"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DomCombo" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          VerticalAlignment="Center"
                          ToolTip="术语按领域隔离：翻译时只命中当前领域的术语"/>

                <StackPanel x:Name="MetaPanel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                    <Separator Margin="0,0,0,8"/>
                    <TextBlock x:Name="CreatedText" FontSize="12"
                               Foreground="{DynamicResource ThirdlyTextBrush}"/>
                    <TextBlock x:Name="UpdatedText" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource ThirdlyTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 页脚：左错误提示、右操作按钮；回车=确定、Esc=取消 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrText" VerticalAlignment="Center" Margin="0,0,170,0" FontSize="12"
                       TextWrapping="Wrap" Foreground="#FFD9534F"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="76" IsCancel="True"/>
                <Button Content="确定" Style="{StaticResource JadeButton}" Width="76" Margin="8,0,0,0"
                        IsDefault="True" Click="Ok"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
