<Window x:Class="TradosToolkit.Workbench.WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TradosToolkit 工作台"
        Width="600" Height="560"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="StatusRow" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,4">
        <StackPanel>
            <!-- 运行状态 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="运行状态" Style="{StaticResource SectionTitle}"/>
                    <Button Grid.Row="0" x:Name="RefreshButton" Content="刷新" Width="64"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource SmallButton}" Margin="0,-4,0,0"
                            Click="Refresh_Click"/>
                    <StackPanel Grid.Row="1" Style="{StaticResource StatusRow}">
                        <Ellipse x:Name="TmDot" Width="9" Height="9" Fill="#C0C6D2"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TmStatusLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Style="{StaticResource StatusRow}">
                        <Ellipse x:Name="LlmDot" Width="9" Height="9" Fill="#C0C6D2"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LlmStatusLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Style="{StaticResource StatusRow}">
                        <Ellipse x:Name="ApiDot" Width="9" Height="9" Fill="#C0C6D2"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ApiStatusLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 网关连通测试 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LLM 网关连通测试" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Content="测试连通" Style="{StaticResource SmallButton}"
                                Click="TestLlm_Click"/>
                        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SmallButton}"
                                Visibility="Collapsed" Click="CancelTest_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TestResultText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="发送一条最小请求验证 Base URL / 模型 / API Key 是否可用（网关正常约 7 秒）。"/>
                </StackPanel>
            </Border>

            <!-- 快捷入口 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="快捷入口" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="翻译提供程序配置…" Style="{StaticResource SmallButton}"
                                Click="OpenProviderConfig_Click"/>
                        <Button Content="术语管理…" Style="{StaticResource SmallButton}"
                                Click="OpenGlossary_Click"/>
                        <Button Content="打开日志目录" Style="{StaticResource SmallButton}"
                                Click="OpenLogFolder_Click"/>
                        <Button Content="打开配置文件位置" Style="{StaticResource SmallButton}"
                                Click="OpenConfigFile_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
