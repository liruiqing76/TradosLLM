<UserControl x:Class="TradosToolkit.Workbench.TranslationCenterNavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BookmarkButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="10,10,10,8">
        <TextBlock DockPanel.Dock="Top" Text="常用地址" FontWeight="Bold" FontSize="13"
                   Margin="2,0,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <Button DockPanel.Dock="Top" x:Name="AddBookmarkButton" Content="＋ 收藏当前页"
                Style="{StaticResource BookmarkButton}" Click="AddBookmark_Click"
                ToolTip="把浏览器当前页加入常用地址（自动保存到 config.json）"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="NavStatus" FontSize="11" Margin="2,6,2,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BookmarkPanel"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
