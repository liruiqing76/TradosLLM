<UserControl x:Class="TradosToolkit.Workbench.TranslationCenterNavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BookmarkButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FolderHeaderButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="10,10,10,8">
        <TextBlock DockPanel.Dock="Top" Text="书签" FontWeight="Bold" FontSize="13"
                   Margin="2,0,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="3" Margin="0,0,0,8">
            <Button Content="＋目录" Style="{StaticResource BookmarkButton}" Margin="0,0,4,0"
                    Click="NewFolder_Click" ToolTip="新建书签目录"/>
            <Button Content="☆收藏" Style="{StaticResource BookmarkButton}" Margin="0,0,4,0"
                    Click="AddBookmark_Click" ToolTip="把浏览器当前页收藏进选中的目录"/>
            <Button Content="⇩导出" Style="{StaticResource BookmarkButton}" Margin="0"
                    Click="Export_Click" ToolTip="导出全部书签为 HTML（Chrome/Edge 可直接导入）"/>
        </UniformGrid>
        <TextBlock DockPanel.Dock="Bottom" x:Name="NavStatus" FontSize="11" Margin="2,6,2,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FolderPanel"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
