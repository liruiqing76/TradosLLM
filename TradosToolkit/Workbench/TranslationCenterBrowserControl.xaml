<UserControl x:Class="TradosToolkit.Workbench.TranslationCenterBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolBarButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                <Setter Property="Padding" Value="9,4"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinWidth" Value="34"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 地址栏工具条 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="◀" Style="{StaticResource ToolBarButton}"
                            ToolTip="后退" Click="Back_Click"/>
                    <Button x:Name="ForwardButton" Content="▶" Style="{StaticResource ToolBarButton}"
                            ToolTip="前进" Click="Forward_Click"/>
                    <Button x:Name="ReloadButton" Content="⟳" Style="{StaticResource ToolBarButton}"
                            ToolTip="刷新" Click="Reload_Click"/>
                    <Button x:Name="HomeButton" Content="⌂" Style="{StaticResource ToolBarButton}"
                            ToolTip="回到主页" Click="Home_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="SetHomePageButton" Content="设为主页"
                        Style="{StaticResource ToolBarButton}" Margin="6,0,0,0" MinWidth="0"
                        ToolTip="把当前地址保存为主页（config.json 的 translationCenterUrl）"
                        Click="SetHome_Click"/>
                <Button DockPanel.Dock="Right" x:Name="GoButton" Content="打开" Margin="6,0,0,0"
                        Style="{DynamicResource ButtonPrimary}" Padding="14,4"
                        Click="Go_Click"/>
                <hc:TextBox x:Name="AddressBox" Margin="8,0" MinHeight="30" VerticalContentAlignment="Center"
                            hc:InfoElement.Placeholder="输入网址后回车打开"
                            Style="{StaticResource TextBoxExtend}"
                            KeyDown="AddressBox_KeyDown"/>
            </DockPanel>
        </Border>

        <!-- 加载进度 -->
        <ProgressBar Grid.Row="1" x:Name="NavProgress" Height="3" Margin="0,6,0,0"
                     IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="12" Margin="2,4,0,4"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <!-- 浏览器（"常用地址"在 View 自带左栏 = GetExplorerBarControl，见 TranslationCenterNavControl） -->
        <Border Grid.Row="3" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
                <TextBlock x:Name="FallbackText" Margin="16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
