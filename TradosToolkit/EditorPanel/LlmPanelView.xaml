<UserControl x:Class="TradosToolkit.EditorPanel.LlmPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
             MinWidth="240"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="SegmentText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 当前段 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="当前段" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <TextBlock x:Name="StatusChip" FontSize="11" Margin="8,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SourceText" Text="(未打开文档)" Style="{StaticResource SegmentText}"/>
                        <TextBlock x:Name="TargetText" Text="" Style="{StaticResource SegmentText}" Margin="0"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="ConfigHint" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="#E05D4B" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 对话记录 -->
        <Border Grid.Row="1" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="8,6">
                <ItemsControl x:Name="ChatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="320" Padding="9,6" CornerRadius="8" Margin="0,4"
                                    HorizontalAlignment="{Binding Align}"
                                    Background="{Binding BubbleBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Time}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <Button Content="写入当前段" FontSize="11" Padding="7,1" Margin="10,0,0,0"
                                                Style="{DynamicResource ButtonDefault}"
                                                Visibility="{Binding ApplyVisibility}"
                                                Tag="{Binding}" Click="ApplyBubble_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 快捷操作 -->
        <WrapPanel Grid.Row="2" x:Name="QuickActions" Margin="0,8,0,6">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="Margin" Value="0,0,6,4"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </WrapPanel.Resources>
            <Button Content="重译" Tag="忽略当前译文，重新翻译源文，给出你认为最准确的译文。" Click="QuickAction_Click"/>
            <Button Content="润色" Tag="在保持原意的前提下润色当前译文，使表达更地道自然。" Click="QuickAction_Click"/>
            <Button Content="精简" Tag="把当前译文精简，去掉冗余，保留核心信息。" Click="QuickAction_Click"/>
            <Button Content="补全" Tag="检查当前译文是否漏译，把译文补充完整。" Click="QuickAction_Click"/>
            <Button Content="查术语" Tag="检查当前译文的术语是否准确一致，修正并简要说明。" Click="QuickAction_Click"/>
            <Button Content="找问题" Tag="解释当前译文可能存在的问题与修改建议。" Click="QuickAction_Click"/>
        </WrapPanel>

        <!-- 输入 -->
        <StackPanel Grid.Row="3">
            <DockPanel>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送"
                        Style="{DynamicResource ButtonPrimary}" Padding="14,4" Margin="6,0,0,0"
                        Click="Send_Click"/>
                <hc:TextBox x:Name="InputBox" MinHeight="46" MaxHeight="120" AcceptsReturn="True"
                            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                            hc:InfoElement.Placeholder="说明修改要求，Enter 发送，Shift+Enter 换行"
                            Style="{StaticResource TextBoxExtend}"
                            ToolTip="Enter 发送，Shift+Enter 换行"
                            PreviewKeyDown="InputBox_PreviewKeyDown"/>
            </DockPanel>
            <CheckBox x:Name="MarkTranslatedCheck" IsChecked="True" Margin="2,5,0,0"
                      Content="写入当前段后标记为“译文”状态"/>
        </StackPanel>
    </Grid>
</UserControl>
