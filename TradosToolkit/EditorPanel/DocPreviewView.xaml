<UserControl x:Class="TradosToolkit.EditorPanel.DocPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
             MinWidth="280"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具条：预览模式 + 刷新 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新"
                        Style="{DynamicResource ButtonDefault}" Padding="10,3" FontSize="12"
                        ToolTip="重新读取当前文档并重建预览" Click="Refresh_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="预览" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox x:Name="ModeBox" Width="96" Margin="10,0,0,0" FontSize="12"
                              VerticalAlignment="Center" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="双语对照" IsSelected="True"/>
                        <ComboBoxItem Content="仅译文"/>
                        <ComboBoxItem Content="仅原文"/>
                    </ComboBox>
                    <TextBlock x:Name="StatusChip" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 渲染面：WebView2 就绪后显示；不可用时退回文字提示 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
            <TextBlock x:Name="FallbackText" Margin="16" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" Text="正在加载预览…"/>
        </Grid>
    </Grid>
</UserControl>
