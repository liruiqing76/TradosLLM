  <ItemGroup>
    <!-- 插件资源 resx 由 SDL 打包任务用 ResGen 单独编译成 .plugin[.culture].resources，
         排除 SDK 默认 EmbeddedResource glob，避免混进主程序集/生成多余卫星 dll -->
    <EmbeddedResource Remove="PluginResources.resx" />
    <EmbeddedResource Remove="PluginResources.zh-CN.resx" />
    <None Include="PluginResources.resx" />
    <None Include="PluginResources.zh-CN.resx" />
    <Resource Include="Resources\workbench.ico" />
    <Resource Include="Resources\translation-center.ico" />
    <Resource Include="Resources\glossary-manager.ico" />
    <Resource Include="Resources\tm-manager.ico" />
    <Resource Include="Resources\inbox.ico" />
    <None Include="pluginpackage.manifest.xml" />
  </ItemGroup>

  <!-- 清单反射器只扫描输出目录/GAC/旧式 csproj HintPath，SDK 风格工程解析不到；
       生成清单前把带 HintPath 的 SDL 依赖复制进输出目录，让 Cci 能解析扩展属性类型。
       打包内容不含这些 dll（包 = 主程序集 + ReferenceCopyLocalPaths + manifest Include）。 -->
  <Target Name="CopySdlRefsForManifestScan" BeforeTargets="GeneratePluginManifestTarget">
    <Copy SourceFiles="@(Reference->'%(HintPath)')"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'%(Reference.HintPath)' != ''" />
    <!-- WebView2 原生加载器：NuGet targets 只放 win-x86 子目录，插件目录无子目录探测，
         拷到输出根随包分发，运行时由 TranslationCenterBrowserControl 按绝对路径 LoadLibrary -->
    <Copy SourceFiles="$(OutDir)runtimes\win-x86\native\WebView2Loader.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)runtimes\win-x86\native\WebView2Loader.dll')" />
  </Target>

  <!-- Studio 2019 签名校验对"已签名但非 OpenX 证书"的包会误判通过（ValidatingPluginLocator
       反编译实证），自签即可去掉每次启动的"未认证插件 Yes/No"弹窗。打完包后签名，
       并覆盖已部署到 Packages 的副本，保证包与 Unpacked 内容一致。 -->
  <Target Name="SignPluginPackage" AfterTargets="GeneratePluginManifestTarget">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\sign-sdlplugin.ps1&quot; -PackagePath &quot;$(TargetDir)$(TargetName).sdlplugin&quot;" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).sdlplugin"
          DestinationFolder="$(PluginDeploymentPath)\Packages"
          SkipUnchangedFiles="false"
          Condition="'$(DeployPluginPackage)' == 'true' And Exists('$(PluginDeploymentPath)\Packages')" />
    <!-- 仓库 release/ 始终放最新签名包，目标机免构建直接取用 -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).sdlplugin"
          DestinationFolder="$(MSBuildProjectDirectory)\..\release"
          SkipUnchangedFiles="false" />
  </Target>

